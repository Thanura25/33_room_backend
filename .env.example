# Server
PORT=4000
# Comma-separate URLs when more than one frontend is allowed.
CORS_ORIGIN=http://localhost:5173

# MongoDB database
MONGODB_URI=mongodb://127.0.0.1:27017/room33_billing
JWT_SECRET=replace_with_a_long_random_secret

# Administrator login: set these in the backend .env, then restart the API.
# Leave all three blank to retain the first-account setup page.
ADMIN_NAME=
ADMIN_EMAIL=
# Required for a new admin; blank preserves an existing admin's password.
# Quote passwords that contain # or leading/trailing spaces.
ADMIN_PASSWORD=

# Meta WhatsApp Cloud API. Leave enabled as false until credentials are configured.
WHATSAPP_ENABLED=false
# Expected sender phone number in international format. Meta must verify this number.
WHATSAPP_SENDER_PHONE_NUMBER=
# Meta's numeric Phone Number ID, not the sender's telephone number.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_API_VERSION=v22.0
# Approved utility template with ten positional body parameters (see README).
WHATSAPP_TEMPLATE_NAME=room33_monthly_utility_bill_v2
WHATSAPP_TEMPLATE_LANGUAGE=en
# Set to 2 only after Meta approves the matching v2 template.
WHATSAPP_TEMPLATE_VERSION=2

# Render.com Keep-Alive (Prevents free tier backend from sleeping after 15 min inactivity)
# Render automatically injects RENDER_EXTERNAL_URL into its web service environments.
# Or you can manually define your public Render backend URL here:
# BACKEND_URL=https://your-backend-app.onrender.com
# KEEP_ALIVE_INTERVAL_MINUTES=10
